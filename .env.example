# Financial Planning System — environment variables
#
# All variables are OPTIONAL. The service runs with zero configuration:
# no database, no auth, no secrets (demo-grade, in-memory store).
#
# Copy to `.env` for local overrides (`.env` is git-ignored).

# Port the HTTP server binds to. Heroku injects PORT automatically; 3003 is
# only the local fallback.
PORT=3003

# Node environment. Set to "production" on Heroku.
NODE_ENV=development
